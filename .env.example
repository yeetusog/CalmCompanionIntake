# --------------------------------------------------
# PUBLIC / browser-safe Supabase configuration
# --------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# --------------------------------------------------
# SERVER-ONLY Supabase secret
# Never prefix this with NEXT_PUBLIC_.
# Current Supabase naming uses a secret key for trusted server code.
# --------------------------------------------------
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Optional: leave empty to use the built-in V1 therapist fallback profile
# until you seed the Ayushi records in Supabase.
# The production submission endpoint requires SUPABASE_SECRET_KEY.
